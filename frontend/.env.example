# Empty means "same origin" -- requests go to /api and Vite proxies them to the
# backend in development. Keep it empty unless the API is on another host.
VITE_API_BASE_URL=

# Where the dev proxy forwards /api. Development only.
VITE_API_PROXY_TARGET=http://localhost:5000

# Leaflet raster tiles. OpenStreetMap needs no token; respect their tile policy
# and switch to a paid provider before any real traffic.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
