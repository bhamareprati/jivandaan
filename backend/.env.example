# ---- Jivandan backend -------------------------------------------------
# Copy to .env and fill in. Never commit .env.

# Database (Doc 2 section 7)
# `npm run db` prints a URI to paste here, or point at a local MongoDB / Atlas cluster.
MONGO_URI=mongodb://127.0.0.1:37017/jivandan_dev?replicaSet=testset

# Secrets -- generate real ones for production:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string
SESSION_SECRET=replace-me-with-a-different-long-random-string

PORT=5000
NODE_ENV=development

# Allowed browser origins (Vite dev server by default)
CORS_ORIGINS=http://localhost:5173

# Domain policy -- configurable, never hard-coded in controllers
DONATION_INTERVAL_DAYS=56
UNIT_SHELF_LIFE_DAYS=42
EXPIRY_RADAR_DAYS=7
LOW_STOCK_THRESHOLD=10

# Atomic inventory writes need a replica set. `npm run db` and Atlas both give
# you one; a plain standalone mongod does not -- set false in that case.
USE_TRANSACTIONS=true

# Seeded super-admin. Admin accounts are never self-registered.
ADMIN_EMAIL=admin@jivandan.in
ADMIN_PASSWORD=ChangeThisAdminPassword1!

# Notification provider (stub -- Doc 2 section 7)
SMS_PROVIDER_KEY=

# Session cookie policy. 'lax' when the SPA is served from the same origin as
# the API (the Vite dev proxy, or a production rewrite) -- it blocks cross-site
# writes outright. Use 'none' ONLY for a genuinely cross-origin deployment; it
# forces secure cookies, and the CSRF guard in middleware/auth.js is what keeps
# that arrangement safe.
COOKIE_SAMESITE=lax

# Nameservers for Node's DNS resolver, comma-separated. Only needed where the
# system resolver cannot answer SRV lookups, which breaks mongodb+srv:// with
# `querySrv ECONNREFUSED`. Leave empty to use the system resolver.
DNS_SERVERS=

# Token lifetimes
JWT_EXPIRES_IN=7d
PASS_EXPIRES_IN=365d
