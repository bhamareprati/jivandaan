{
  "info": {
    "name": "Jivandan API",
    "description": "Jivandan - real-time blood donation and inventory network.\n\nEvery route in the Document 2 route map, in the order you would exercise them.\n\nSetup:\n1. Run `npm run db`, `npm run seed:reset`, then `npm run dev`.\n2. Select the \"Jivandan Local\" environment (or edit the collection variables).\n3. Run the four requests under `Auth / Sign in as ...` first - each one captures its own token into a collection variable, and every later request uses it.\n\nSeeded password for all accounts: Passw0rd!",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "password", "value": "Passw0rd!" },
    { "key": "donorToken", "value": "" },
    { "key": "bankToken", "value": "" },
    { "key": "hospitalToken", "value": "" },
    { "key": "adminToken", "value": "" },
    { "key": "donorId", "value": "" },
    { "key": "bankId", "value": "" },
    { "key": "hospitalId", "value": "" },
    { "key": "requestId", "value": "" },
    { "key": "passToken", "value": "" },
    { "key": "pendingBankId", "value": "" }
  ],
  "item": [
    {
      "name": "System",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/api/health", "host": ["{{baseUrl}}"], "path": ["api", "health"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 and db connected', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().data.db).to.eql('connected');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Sign in as donor",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"asha0@donor.test\",\n  \"password\": \"{{password}}\",\n  \"role\": \"donor\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in', function () { pm.response.to.have.status(200); });",
                  "var d = pm.response.json().data;",
                  "pm.collectionVariables.set('donorToken', d.token);",
                  "pm.collectionVariables.set('donorId', d.user.id || d.user._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in as blood bank",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"sahyadri@bank.test\",\n  \"password\": \"{{password}}\",\n  \"role\": \"blood-bank\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in', function () { pm.response.to.have.status(200); });",
                  "var d = pm.response.json().data;",
                  "pm.collectionVariables.set('bankToken', d.token);",
                  "pm.collectionVariables.set('bankId', d.user.id || d.user._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in as hospital",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"rubyhall@hospital.test\",\n  \"password\": \"{{password}}\",\n  \"role\": \"hospital\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in', function () { pm.response.to.have.status(200); });",
                  "var d = pm.response.json().data;",
                  "pm.collectionVariables.set('hospitalToken', d.token);",
                  "pm.collectionVariables.set('hospitalId', d.user.id || d.user._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Sign in as admin",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@jivandan.in\",\n  \"password\": \"{{password}}\",\n  \"role\": \"admin\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in', function () { pm.response.to.have.status(200); });",
                  "pm.collectionVariables.set('adminToken', pm.response.json().data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/register (donor)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"donor\",\n  \"name\": \"New Donor\",\n  \"email\": \"new.donor@example.in\",\n  \"password\": \"Passw0rd!\",\n  \"contact\": \"9876500099\",\n  \"dob\": \"1996-07-21\",\n  \"gender\": \"female\",\n  \"bloodgroup\": \"B+\",\n  \"city\": \"Pune\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "POST /api/auth/register (blood bank)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"blood-bank\",\n  \"name\": \"New Blood Bank\",\n  \"email\": \"new.bank@example.in\",\n  \"password\": \"Passw0rd!\",\n  \"contact\": \"02029990000\",\n  \"address\": \"22 Example Road\",\n  \"city\": \"Pune\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"411004\",\n  \"coordinates\": [73.8567, 18.5204],\n  \"licenseNumber\": \"MH-PUN-9999\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "POST /api/auth/register (hospital)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role\": \"hospital\",\n  \"name\": \"New Hospital\",\n  \"email\": \"new.hospital@example.in\",\n  \"password\": \"Passw0rd!\",\n  \"contact\": \"02028880000\",\n  \"address\": \"5 Example Marg\",\n  \"city\": \"Pune\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"411005\",\n  \"registrationNumber\": \"HOSP-MH-9999\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "GET /api/auth/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{donorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/me", "host": ["{{baseUrl}}"], "path": ["api", "auth", "me"] }
          }
        },
        {
          "name": "POST /api/auth/forgot-password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"asha0@donor.test\",\n  \"role\": \"donor\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "forgot-password"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var d = pm.response.json().data;",
                  "if (d && d.resetToken) { pm.collectionVariables.set('resetToken', d.resetToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/reset-password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"role\": \"donor\",\n  \"newPassword\": \"Passw0rd!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "reset-password"] }
          }
        },
        {
          "name": "POST /api/auth/logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{donorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"] }
          }
        },
        {
          "name": "RBAC check: donor token on an admin route (expect 403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{donorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/admin/metrics", "host": ["{{baseUrl}}"], "path": ["api", "admin", "metrics"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": ["pm.test('403 forbidden', function () { pm.response.to.have.status(403); });"]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Donor",
      "item": [
        {
          "name": "GET /api/donors/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{donorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/donors/me", "host": ["{{baseUrl}}"], "path": ["api", "donors", "me"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('56-day eligibility present', function () {",
                  "  pm.expect(pm.response.json().data.eligibility.intervalDays).to.eql(56);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /api/donors/me",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{donorToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"contact\": \"9876500123\",\n  \"city\": \"Pune\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/donors/me", "host": ["{{baseUrl}}"], "path": ["api", "donors", "me"] }
          }
        },
        {
          "name": "GET /api/donors/me/pass",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{donorToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/donors/me/pass", "host": ["{{baseUrl}}"], "path": ["api", "donors", "me", "pass"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "var d = pm.response.json().data;",
                  "pm.collectionVariables.set('passToken', d.pass.qrPayload);",
                  "pm.test('QR payload is a signed token', function () {",
                  "  pm.expect(d.pass.qrPayload.split('.')).to.have.lengthOf(3);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/donors/feed",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{donorToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/donors/feed?page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "donors", "feed"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Blood Bank & Inventory",
      "item": [
        {
          "name": "GET /api/banks (radius search)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{donorToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/banks?lat=18.5204&lng=73.8567&radius=25000",
              "host": ["{{baseUrl}}"],
              "path": ["api", "banks"],
              "query": [
                { "key": "lat", "value": "18.5204" },
                { "key": "lng", "value": "73.8567" },
                { "key": "radius", "value": "25000", "description": "metres - the UI offers 5000 / 10000 / 25000" }
              ]
            }
          }
        },
        {
          "name": "GET /api/banks (city fallback)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{donorToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/banks?city=Mumbai&bloodGroup=O%2B&minUnits=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "banks"],
              "query": [
                { "key": "city", "value": "Mumbai" },
                { "key": "bloodGroup", "value": "O%2B" },
                { "key": "minUnits", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "GET /api/banks/:id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bankToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/banks/{{bankId}}", "host": ["{{baseUrl}}"], "path": ["api", "banks", "{{bankId}}"] }
          }
        },
        {
          "name": "GET /api/banks/:id/inventory",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bankToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/banks/{{bankId}}/inventory", "host": ["{{baseUrl}}"], "path": ["api", "banks", "{{bankId}}", "inventory"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('all eight groups always present', function () {",
                  "  pm.expect(pm.response.json().data.groups).to.have.lengthOf(8);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PATCH /api/banks/:id/inventory",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bankToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"inventory\": { \"AB-\": 6 },\n  \"reason\": \"stock take\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/api/banks/{{bankId}}/inventory", "host": ["{{baseUrl}}"], "path": ["api", "banks", "{{bankId}}", "inventory"] }
          }
        },
        {
          "name": "POST /api/banks/:id/checkin (QR pass)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bankToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"passToken\": \"{{passToken}}\",\n  \"units\": 1\n}"
            },
            "description": "Run GET /api/donors/me/pass first to capture passToken.\n\nA second check-in for the same donor is refused with 422 until the 56-day interval has passed - the rule is enforced on the write path, not just displayed.",
            "url": { "raw": "{{baseUrl}}/api/banks/{{bankId}}/checkin", "host": ["{{baseUrl}}"], "path": ["api", "banks", "{{bankId}}", "checkin"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  var d = pm.response.json().data.donation;",
                  "  var days = Math.round((new Date(d.expiryDate) - new Date(d.donationDate)) / 86400000);",
                  "  pm.test('expiry is donationDate + 42 days', function () { pm.expect(days).to.eql(42); });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/banks/:id/expiry-radar",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bankToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/banks/{{bankId}}/expiry-radar?windowDays=7",
              "host": ["{{baseUrl}}"],
              "path": ["api", "banks", "{{bankId}}", "expiry-radar"],
              "query": [{ "key": "windowDays", "value": "7" }]
            }
          }
        },
        {
          "name": "POST /api/banks/:id/reconcile",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{bankToken}}" }],
            "description": "Rebuilds the cached inventory Map from the donation ledger. The ledger is the source of truth; this repairs any drift.",
            "url": { "raw": "{{baseUrl}}/api/banks/{{bankId}}/reconcile", "host": ["{{baseUrl}}"], "path": ["api", "banks", "{{bankId}}", "reconcile"] }
          }
        }
      ]
    },
    {
      "name": "Blood Requests",
      "item": [
        {
          "name": "POST /api/requests (critical)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{hospitalToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bloodGroup\": \"O+\",\n  \"units\": 2,\n  \"urgency\": \"critical\",\n  \"bloodBank\": \"{{bankId}}\",\n  \"patientName\": \"Trauma admission\",\n  \"hospitalName\": \"Ruby Hall Clinic\"\n}"
            },
            "description": "Creating at `critical` urgency fires the notification hook - watch the server log for the [notify:...] lines.",
            "url": { "raw": "{{baseUrl}}/api/requests", "host": ["{{baseUrl}}"], "path": ["api", "requests"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('created', function () { pm.response.to.have.status(201); });",
                  "var d = pm.response.json().data;",
                  "pm.collectionVariables.set('requestId', d.request.id || d.request._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/requests/:id (tracker stepper)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{hospitalToken}}" }],
            "url": { "raw": "{{baseUrl}}/api/requests/{{requestId}}", "host": ["{{baseUrl}}"], "path": ["api", "requests", "{{requestId}}"] }
          }
        },
        {
          "name": "PATCH status -> under_review",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bankToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"under_review\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/requests/{{requestId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "requests", "{{requestId}}", "status"] }
          }
        },
        {
          "name": "PATCH status -> approved",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bankToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"approved\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/requests/{{requestId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "requests", "{{requestId}}", "status"] }
          }
        },
        {
          "name": "PATCH status -> dispatched",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bankToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"dispatched\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/requests/{{requestId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "requests", "{{requestId}}", "status"] }
          }
        },
        {
          "name": "PATCH status -> fulfilled (consumes stock)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bankToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"fulfilled\"\n}" },
            "description": "Fulfilment draws units first-expiring-first-out, in the same transaction as the status change. Insufficient stock returns 409 and the status does not move.",
            "url": { "raw": "{{baseUrl}}/api/requests/{{requestId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "requests", "{{requestId}}", "status"] }
          }
        },
        {
          "name": "PATCH status -> fulfilled from pending (expect 409)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{bankToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"fulfilled\"\n}" },
            "description": "The illegal jump named in the Document 4 QA checklist. Run this against a freshly created (pending) request.",
            "url": { "raw": "{{baseUrl}}/api/requests/{{requestId}}/status", "host": ["{{baseUrl}}"], "path": ["api", "requests", "{{requestId}}", "status"] }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 invalid transition', function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/requests (queue, filterable)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bankToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/requests?urgency=critical&page=1&limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests"],
              "query": [
                { "key": "urgency", "value": "critical" },
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "GET /api/requests/match/:bloodGroup",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{bankToken}}" }],
            "description": "Universal compatibility matching. With ?bankId= it ranks that bank's real stock, exact match first and rare groups preserved.",
            "url": {
              "raw": "{{baseUrl}}/api/requests/match/AB%2B?bankId={{bankId}}&units=2",
              "host": ["{{baseUrl}}"],
              "path": ["api", "requests", "match", "AB%2B"],
              "query": [
                { "key": "bankId", "value": "{{bankId}}" },
                { "key": "units", "value": "2" }
              ]
            }
          }
        }
      ]
    },
